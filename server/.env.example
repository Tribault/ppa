# Copy to .env and fill in real values. Never commit .env.
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017/postersDB
PORT=5000
# Get an API key at https://resend.com/api-keys — needs the sending domain verified first.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
ADMIN_EMAIL=
# Get a free API Read Access Token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Real deployed frontend URL — used in password-reset/verification emails and CORS.
FRONTEND_URL=
